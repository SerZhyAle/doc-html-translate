{
  "about": "The paired capabilities scripts/parity-check.ps1 watches for one-sided changes. Hand-maintained: it is the machine-readable twin of the port map table in docs/PARITY.md, and tests/parity_map_test.go fails when the two disagree. A path ending in '/' covers everything under it.",
  "pairs": [
    { "name": "PDF (reflow / TOC / page images)", "go": ["internal/pdf/"], "js": ["extension/src/reflow.js", "extension/src/toc.js", "extension/src/pdf-images.js"] },
    { "name": "EPUB (unzip / spine / TOC)", "go": ["internal/epub/"], "js": ["extension/src/epub.js"] },
    { "name": "Plain text (paragraphs / decode)", "go": ["internal/txt/"], "js": ["extension/src/txt.js"] },
    { "name": "RTF", "go": ["internal/rtf/"], "js": ["extension/src/rtf.js"] },
    { "name": "Markdown", "go": ["internal/md/"], "js": ["extension/src/md.js"] },
    { "name": "FB2", "go": ["internal/fb2/"], "js": ["extension/src/fb2.js"] },
    { "name": "HTML body extract", "go": ["internal/htmlconv/"], "js": ["extension/src/html.js"] },
    { "name": "MOBI / AZW3", "go": ["internal/mobi/"], "js": ["extension/src/ebook.js"] },
    { "name": "Comic archives (CBZ/CBR/CB7/CBT)", "go": ["internal/comic/"], "js": ["extension/src/comic.js"] },
    { "name": "Input limits (archive budget / capped inflation)", "go": ["internal/limits/"], "js": ["extension/src/limits.js"] },
    { "name": "OCR overlay / language", "go": ["internal/ocr/"], "js": ["extension/src/ocr-overlay.js", "extension/src/ocr-plates.js", "extension/src/ocr-cluster.js", "extension/src/ocr-text.js", "extension/src/ocr-lang.js"] },
    { "name": "Reader chrome (themes/fonts/UI)", "go": ["internal/htmlgen/navbar.go"], "js": ["extension/src/viewer.css", "extension/src/viewer.js", "extension/src/viewer.html"] },
    { "name": "Vocabulary glyphs (ICON-SET)", "go": ["internal/htmlgen/glyphs.go"], "js": ["extension/src/glyphs.js"] },
    { "name": "Settings / options surface", "go": ["internal/config/flags.go", "cmd/doc-html-ui/ui.html"], "js": ["extension/src/popup.js", "extension/src/options.js", "extension/src/background.js"] }
  ],
  "notWatched": [
    { "path": "internal/pipeline/pipeline.go", "reason": "the port map pairs only the comic forced-OCR decision in it with viewer.js; the file carries the whole conversion pipeline, so watching it would flag nearly every pipeline change as drift" }
  ],
  "acknowledge": ["docs/PARITY.md", "tests/parity_test.go", "tests/iconography_test.go", "configs/parity-map.json"]
}
