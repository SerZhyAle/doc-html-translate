temp/
*.out
*.test
coverage.out
*.exe
# The machine's own Claude Code settings (the owner's choice, ticket E0111 F4); .claude/commands, agents and
# settings.json stay versioned and public.
.claude/settings.local.json
# pdftotext and its three MinGW runtime DLLs are a vendored upstream binary (Xpdf 4.00 via Git for Windows, see internal/bundledtools/PROVENANCE.txt), not build
# output - the converter shells out to them and they ship inside every package. The exe is tracked too:
# the CI release build embeds only what a clean checkout holds (ticket 35).
!internal/bundledtools/pdftotext/*.dll
!internal/bundledtools/pdftotext/pdftotext.exe
# Extracted EPUB directories in test_epub
test_epub/
test_pdf/
test_txt/
# Local sample documents used by the integration tests (tests/testdoc_test.go).
# The files are private and must never be committed; the tests skip when absent.
test_doc/
# The OCR visual-fidelity corpus lives under test_doc/ and is therefore already ignored - this
# line is here so the rule is findable from the lab's own docs. Only the metadata is committed
# (DEV/ocrlab/corpus.json + annotations); the media is third-party work and ships in nothing.
test_doc/ocrlab/
# tesseract.js caches language data next to the process that asked for it, so running the
# extension's lab (npm run ocrlab) drops a 4 MB eng.traineddata in extension/. The bundled copy is
# the one under extension/vendor, written by build.mjs; this stray sibling is a run artefact and
# must never reach a commit or the packaged extension.
extension/*.traineddata
DEV/private/
# Local planning tickets and release queue.
DEV/plan/
DEV/DOCUMENT_REGISTRY.jsonl
# Secrets and signing material - pre-empt the leak, never catch it afterwards.
*.pfx
*.snk
*.jks
*.keystore
.env
*token*
*secret*
# ..except the in-app help of the FileDO password dialog: a published page, not a secret (CONTEXT-HELP rules 12, 15).
!cmd/doc-html-ui/help/*/secret-file-password*
!help/*/secret-file-password*
!tools/helpgen/copy/secret-file-password.json
