# Copy to extension/.env and fill in. .env is git-ignored - never commit real values.
# Real CI environment variables override .env, so the same scripts work locally and in CI.

# ---- Chrome Web Store (V2 API) ---------------------------------------------
# Your developer/publisher GUID (from the devconsole URL). Not a secret, but kept as a
# placeholder here so secret scanners don't flag the UUID; put the real value in .env.
CWS_PUBLISHER_ID=your-developer-publisher-guid
# The 32-char item ID - exists only AFTER you create the item once in the dashboard.
CWS_EXTENSION_ID=

# Auth - pick ONE. Service account is recommended (no token expiry).
# (A) Service account: paste the JSON key inline, OR point to a file path.
#CWS_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}
#CWS_SERVICE_ACCOUNT_KEY_FILE=./cws-key.json
# (B) OAuth fallback (refresh token; needs the consent screen published to production):
#CWS_CLIENT_ID=
#CWS_CLIENT_SECRET=
#CWS_REFRESH_TOKEN=

# ---- Microsoft Edge Add-ons (Partner Center API v1.1) ----------------------
EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=
#EDGE_NOTES=Automated submission.
